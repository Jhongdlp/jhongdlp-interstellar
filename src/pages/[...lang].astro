---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Gallery from '../components/Gallery.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { tr } from '../i18n';

// "/" is Spanish, "/en/" English
export const getStaticPaths = () => [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
const t = tr(Astro.currentLocale);
---

<Base title={t('Jhon — Portafolio', 'Jhon — Portfolio')} description={t('Jhon (jhongdlp), desarrollador full-stack y especialista en IA en Quito, Ecuador. Creo productos inteligentes del concepto a la producción.', 'Jhon (jhongdlp), full-stack developer and AI specialist in Quito, Ecuador. I build intelligent products from concept to production.')}>
  <Loader />
  <Header />
  <main>
    <Hero />
    <Work />
    <Gallery />
    <Contact />
  </main>
  <Footer />
</Base>
