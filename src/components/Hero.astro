---
import { siAnthropic, siDocker, siFastapi, siFramer, siGit, siGithub, siHuggingface, siJupyter, siLangchain, siLinux, siNextdotjs,
  siNodedotjs, siNumpy, siOllama, siPandas, siPostgresql, siPostman, siPython, siPytorch, siReact, siSupabase, siTailwindcss,
  siTensorflow, siTypescript, siVercel } from 'simple-icons';
import { tr } from '../i18n';
const en = Astro.currentLocale === 'en';
const t = tr(Astro.currentLocale);

// Skills: simple-icons glyphs, or a short text tile where there is no logo
type Skill = { title: string; path?: string; text?: string };
const stack: [string, Skill[]][] = [
  ['Frontend', [siNextdotjs, siReact, siTypescript, siTailwindcss, siFramer]],
  ['Backend', [siPython, siNodedotjs, siFastapi, siPostgresql, siSupabase, siDocker]],
  [t('IA y datos', 'AI & data'), [siAnthropic, siLangchain, siHuggingface, siPytorch, siTensorflow, siOllama, siNumpy, siPandas,
    { title: 'Seaborn', text: 'sns' }, { title: 'Matplotlib', text: 'plt' }, siJupyter]],
  [t('Herramientas', 'Tools'), [siGit, siGithub, siVercel, siPostman, siLinux]],
];
let n = 0; // running index for the staggered entrance
const headline = t('Creo productos inteligentes, del concepto a la producción.', 'I build intelligent products, from concept to production.').split(' ');
// Full-screen black hole scene; scrolling pushes the camera in on the person for the "Sobre mí" block.
---

<div class="dive">
<section class="hero">
  <canvas aria-hidden="true"></canvas>
  <a class="sig" href={en ? '/en/' : '/'} aria-label={t('jhongdlp — inicio', 'jhongdlp — home')}>
    <span class="sig-name" aria-hidden="true"><span class="l">J</span>{[...'hongdlp'].map((c) => <span class="l">{c}</span>)}<sup>®</sup></span>
    <span class="mono">{t('Portafolio', 'Portfolio')} · ©2026</span>
  </a>
  <button class="fs" type="button" aria-pressed="false" aria-label={t('Pantalla completa', 'Fullscreen')} title={t('Pantalla completa', 'Fullscreen')}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path class="in" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
      <path class="out" d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
    </svg>
  </button>
</section>

<!-- Same pinned scene: scrolling, the lens finds the person at the tailgate and the text takes the free side. -->
<span id="sobre-mi" class="anchor"></span>
<section class="about" aria-labelledby="sobre-mi-t">
  <div class="skills" aria-label="Stack">
    {stack.map(([group, items]) => (
      <div class="group">
        <h3 class="mono">{group}</h3>
        <ul>
          {items.map((s) => (
            <li title={s.title} style={`--i:${n++}`}>
              {s.path ? <svg viewBox="0 0 24 24" role="img" aria-label={s.title}><path d={s.path} /></svg> : <span aria-label={s.title}>{s.text}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="copy">
    <h2 id="sobre-mi-t" style="--d:0">{headline.map((w, i) => <><span class:list={['w', { thin: i < 3 }]}><span style={`--i:${i}`}>{w}</span></span>{' '}</>)}</h2>
    {en
      ? <p class="lead" style="--d:1"><span class="first">Full-stack developer and AI specialist connecting people with brands and businesses through code and intelligent design.</span> A blend of solid engineering and refined execution to deliver premium results — or, put another way, <strong>“making great things on the internet”</strong>.</p>
      : <p class="lead" style="--d:1"><span class="first">Desarrollador full-stack y especialista en IA que conecta personas con marcas y negocios a través de código y diseño inteligente.</span> Una combinación de ingeniería sólida y ejecución refinada para entregar resultados premium — o dicho de otro modo, <strong>«crear cosas geniales en internet»</strong>.</p>}
    <ul class="facts" style="--d:2">
      <li>Quito, Ecuador</li>
      <li class="num">0°13′S 78°31′{t('O', 'W')}</li>
      <li class="num"><time class="clock">--:--:--</time></li>
      <li class="live">{t('Disponible para proyectos', 'Available for projects')}</li>
    </ul>
  </div>
</section>
</div>

<script>
  import { tr } from '../i18n';
  const t = tr(document.documentElement.lang);
  // Load three.js only after first paint, and only render while the hero is on screen.
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const canvas = hero.querySelector('canvas')!;

  // The scene stays pinned while the page scrolls through .dive; shot = 0..1 is the camera move from the
  // hero framing to the person (push in, drift aside), then the text. p = 0..1 fades the signature out early.
  const dive = hero.parentElement!;
  const about = dive.querySelector<HTMLElement>('.about')!;
  const sig = hero.querySelector<HTMLElement>('.sig')!;
  let p = 0, shot = 0, fall = 0;
  let scene: { shot(v: number): void; fall(v: number): void } | null = null;
  let run = () => {}; // (re)decides whether the scene renders
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches; // no camera move: the hero just scrolls away
  const onScroll = () => {
    if (still) return;
    // track in svh: 0-240 camera finds the person, 240-280 hold, 280-440 fall into the hole
    const u = -dive.getBoundingClientRect().top / (hero.offsetHeight / 100);
    const clamp = (x: number) => Math.min(Math.max(x, 0), 1);
    shot = clamp(u / 240);
    fall = clamp((u - 280) / 160);
    p = Math.min(shot / 0.25, 1);
    sig.style.setProperty('--p', p.toFixed(4));
    scene?.shot(shot);
    scene?.fall(fall);
    hero.classList.toggle('falling', fall > 0);
    // text only once the camera has settled on its third; hysteresis so it doesn't flicker at the edge
    about.classList.toggle('on', fall < 0.04 && shot > (about.classList.contains('on') ? 0.62 : 0.7));
    run();
  };
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', onScroll);
  onScroll();

  // Gravity on the signature: letters are pulled (and spaghettified) toward the black hole and the cursor.
  const letters = [...sig.querySelectorAll<HTMLElement>('.l')];
  const cur = letters.map(() => ({ x: 0, y: 0 }));
  let mx = -1e4, my = -1e4;
  addEventListener('pointermove', (e) => { mx = e.clientX; my = e.clientY; });
  document.addEventListener('pointerleave', () => { mx = my = -1e4; });

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gravity = (t: number) => {
    if (reduceMotion) return;
    // read all layout first, then write (no layout thrash)
    const h = hero.getBoundingClientRect(), s = sig.getBoundingClientRect();
    const hx = h.left + h.width / 2, hy = h.top + h.height * 0.725;  // hole center (CENTER_Y)
    const pos = letters.map((l) => [s.left + l.offsetLeft + l.offsetWidth / 2, s.top + l.offsetTop + l.offsetHeight / 2]);

    letters.forEach((l, i) => {
      const [px, py] = pos[i];
      // the hole: a constant tidal tug that breathes, swallowing the name as you scroll away
      let dx = hx - px, dy = hy - py, d = Math.hypot(dx, dy) || 1;
      const hole = 5 + 3 * Math.sin(t * 0.7 + i * 0.6) + p * p * d * 0.9;
      let fx = (dx / d) * hole, fy = (dy / d) * hole;
      // the cursor: a small gravity well, 1/r² falloff softened by R
      dx = mx - px; dy = my - py; d = Math.hypot(dx, dy) || 1;
      const R = 150, well = (R * R) / (d * d + R * R) * Math.min(d, 46);
      fx += (dx / d) * well; fy += (dy / d) * well;

      const c = cur[i], ease = 0.06 + i * 0.012; // each letter lags a bit differently: feels like matter
      c.x += (fx - c.x) * ease; c.y += (fy - c.y) * ease;
      const st = Math.min(Math.hypot(c.x, c.y) / 70, 2.5), a = Math.atan2(c.y, c.x);
      l.style.transform = `translate(${c.x}px,${c.y}px) rotate(${a}rad) scale(${1 + st},${1 / Math.sqrt(1 + st)}) rotate(${-a}rad)`;
      l.style.opacity = String(1 - p * p);
    });
  };

  // Local time in Quito, like a live readout under the text.
  const clock = about.querySelector<HTMLTimeElement>('.clock')!;
  const fmt = new Intl.DateTimeFormat('es-EC', { timeZone: 'America/Guayaquil', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
  const tick = () => { clock.textContent = `${fmt.format(new Date())} GMT-5`; };
  tick();
  setInterval(tick, 1000);

  // Fullscreen: hide every overlay and leave just the scene. Esc (or the button) brings it all back.
  const fs = hero.querySelector<HTMLButtonElement>('.fs')!;
  const setClean = (on: boolean) => {
    document.documentElement.classList.toggle('clean', on);
    fs.setAttribute('aria-pressed', String(on));
    fs.ariaLabel = fs.title = on ? t('Salir de pantalla completa', 'Exit fullscreen') : t('Pantalla completa', 'Fullscreen');
  };
  fs.addEventListener('click', () => {
    const clean = document.documentElement.classList.contains('clean');
    if (document.fullscreenElement) return void document.exitFullscreen();
    if (!clean) dive.scrollIntoView();
    // iPhone Safari has no element fullscreen (or it can be refused): then just hide the overlays
    if (!document.fullscreenEnabled || clean) return setClean(!clean);
    document.documentElement.requestFullscreen().catch(() => setClean(true));
  });
  document.addEventListener('fullscreenchange', () => setClean(!!document.fullscreenElement));

  import('../scripts/blackhole').then(async ({ createBlackHole }) => {
    const bh = await createBlackHole(canvas, gravity);
    hero.classList.add('ready'); // an un-rendered canvas is transparent, so the CSS fallback still shows
    if (!bh) return;
    scene = bh;
    bh.shot(shot);
    bh.fall(fall);
    // render only while on screen
    let seen = false, on = false;
    run = () => {
      const want = seen;
      if (want !== on) (on = want) ? bh.start() : bh.stop();
    };
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; run(); }).observe(hero);
  }).catch(() => hero.classList.add('ready')); // chunk failed to load: let the loader go, the CSS fallback shows
</script>

<style>
  /* scroll track: the scene stays pinned for 440svh: camera finds the person, holds, then falls into the hole */
  .dive { position: relative; height: 540svh; }
  .hero {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    /* fallback while WebGL loads (or if it is unavailable) */
    background: radial-gradient(ellipse 40% 45% at 50% 75%, #000 60%, transparent 61%),
      radial-gradient(ellipse 60% 60% at 50% 75%, rgba(255, 150, 60, .35), transparent 70%),
      linear-gradient(to top, #2a1405 0 25%, #000 25%);
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  @media (prefers-reduced-motion: reduce) { .dive { height: auto; } }

  /* ---------- about: pinned over the same scene (sticky + pulled up 100svh), text on the free third ---------- */
  .anchor { position: absolute; top: 220svh; } /* nav target: camera settled, text shown */
  .about {
    position: sticky;
    top: 0;
    height: 100svh;
    margin-top: -100svh;
    display: grid;
    grid-template-columns: 1fr auto auto;   /* free space for the person | skills | text */
    align-items: center;
    column-gap: clamp(32px, 4.5vw, 88px);
    padding: 0 clamp(16px, 6vw, 110px);
    pointer-events: none;
  }
  .skills { grid-column: 2; position: relative; display: grid; gap: 18px; color: #f6e4c6; }
  .group { display: grid; gap: 8px; }
  /* group header: name and a hairline */
  .group h3 { display: flex; align-items: center; gap: 10px; max-width: calc(6 * 36px + 5 * 6px); font-size: 10px; font-weight: 400; color: inherit; }
  .group h3::after { content: ''; flex: 1; height: 1px; background: currentColor; opacity: .25; }
  .group ul { display: flex; flex-wrap: wrap; gap: 6px; max-width: calc(6 * 36px + 5 * 6px); list-style: none; }
  .group li {
    display: grid; place-items: center;
    width: 36px; height: 36px;
    border: 1px solid rgba(246, 228, 198, .22);
    border-radius: 9px;
    background: rgba(0, 0, 0, .55); /* no backdrop-filter: 25 blurs over a live canvas cost every frame */
    font-family: var(--font-mono); font-size: 11px;
    /* entrance: tiles light up one after another, like instruments on a dashboard */
    opacity: 0; scale: .8;
    transition: opacity .5s, scale .7s cubic-bezier(.16, 1, .3, 1), border-color .3s, background .3s;
    transition-delay: calc(var(--i) * 18ms);
  }
  .group svg { width: 16px; height: 16px; fill: currentColor; }
  .on .group li, .about:focus-within .group li { opacity: 1; scale: 1; transition-delay: calc(.35s + var(--i) * 28ms), calc(.35s + var(--i) * 28ms), 0s, 0s; }
  .on .skills { pointer-events: auto; }
  .group li:hover { border-color: rgba(246, 228, 198, .7); background: rgba(246, 228, 198, .1); }
  .group h3 { opacity: 0; transition: opacity .8s .3s; }
  .on .group h3 { opacity: 1; }
  /* scrim: darkens only the side the text sits on, so it reads over the glowing horizon */
  .about::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to left, rgba(0, 0, 0, .9), rgba(0, 0, 0, .75) 40%, rgba(0, 0, 0, .45) 62%, transparent 78%);
    opacity: 0;
    transition: opacity 1.4s cubic-bezier(.16, 1, .3, 1);
  }
  .copy { grid-column: 3; position: relative; width: min(34vw, 32rem); display: grid; gap: clamp(16px, 2vw, 26px); }

  /* entrance: same language as the signature (blur to focus), staggered like a camera pulling focus */
  .copy > * {
    opacity: 0;
    filter: blur(8px);
    translate: 0 18px;
    transition: opacity .9s, filter 1.1s, translate 1.2s cubic-bezier(.16, 1, .3, 1);
    transition-delay: calc(var(--d) * 110ms);
  }
  .on::before, .about:focus-within::before { opacity: 1; }
  .on .copy > *, .about:focus-within .copy > * { opacity: 1; filter: none; translate: 0; transition-delay: calc(.25s + var(--d) * 140ms); }

  /* one solid color for all the text (no alpha, no accent): hierarchy comes from size and weight only */
  .copy { color: #f6e4c6; }
  h2 {
    font-weight: 600;
    font-size: clamp(28px, 3vw, 50px);
    line-height: 1.05;
    letter-spacing: -.035em;
    text-wrap: balance;
    text-shadow: 0 2px 30px rgba(0, 0, 0, .6);
  }
  .lead { font-size: clamp(16px, 1.15vw, 18px); line-height: 1.6; max-width: 44ch; text-shadow: 0 1px 20px rgba(0, 0, 0, .6); }

  .facts {
    display: flex; flex-wrap: wrap;
    list-style: none;
    padding-top: 20px;
    border-top: 1px solid rgba(243, 217, 177, .25);
    font-size: 13px; font-weight: 500; letter-spacing: .02em;
  }
  /* availability: a dot that breathes like the disk's glow */
  .live::after {
    content: ''; display: inline-block; vertical-align: middle;
    width: 6px; height: 6px; margin-left: 10px; border-radius: 50%;
    background: currentColor;
    animation: live 2.4s ease-in-out infinite;
  }
  @keyframes live { 50% { box-shadow: 0 0 0 5px transparent, 0 0 12px currentColor; opacity: .55; } }
  /* the divider draws in from the left once the text lands */
  .facts { border-top: 0; position: relative; gap: 8px 22px; align-items: baseline; }
  .facts::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(to right, currentColor, transparent);
    opacity: .35; transform-origin: left; scale: 0 1;
    transition: scale 1.6s cubic-bezier(.16, 1, .3, 1) .6s;
  }
  .on .facts::before, .about:focus-within .facts::before { scale: 1 1; }
  /* hierarchy without a second color: weight contrast in the headline, a larger lead-in sentence */
  h2 .thin { font-weight: 300; }
  .lead .first { display: block; margin-bottom: .6em; font-size: 1.18em; line-height: 1.45; font-weight: 500; }
  /* the signature line gets an underline that draws itself after everything has landed */
  .lead strong {
    font-weight: 600;
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    transition: background-size 1.2s cubic-bezier(.16, 1, .3, 1) 1.4s;
  }
  .on .lead strong, .about:focus-within .lead strong { background-size: 100% 1px; }

  .num { font-family: var(--font-mono); font-weight: 300; font-size: 12px; font-variant-numeric: tabular-nums; letter-spacing: .04em; }

  /* headline: each word rises out of its own mask, one after another */
  .copy > h2 { opacity: 1; filter: none; translate: 0; }
  .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .1em; margin-bottom: -.1em; }
  .w > span { display: inline-block; translate: 0 110%; transition: translate 1.1s cubic-bezier(.16, 1, .3, 1) calc(var(--i) * 45ms); }
  .on .w > span, .about:focus-within .w > span { translate: 0; transition-delay: calc(.2s + var(--i) * 55ms); }

  /* phone: the person sits high in frame, text at the bottom above the floating nav */
  @media (max-width: 640px), (max-aspect-ratio: 1/1) {
    .about { grid-template-columns: 1fr; align-content: end; row-gap: 20px; padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
    .copy, .skills { grid-column: 1; }
    /* skills become one swipeable strip under the text */
    .skills { order: 2; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin-inline: -16px; padding-inline: 16px; }
    .group { display: contents; }
    .group h3 { display: none; }
    .group ul { display: contents; }
    .group li { flex: none; width: 32px; height: 32px; }
    .facts { gap: 6px 16px; }
    .about::before { background: linear-gradient(to top, rgba(0, 0, 0, .92), rgba(0, 0, 0, .7) 55%, transparent 85%); }
    h2 { font-size: 27px; }
    .lead { font-size: 15px; }
    .copy { width: auto; }
  }

  /* no motion: no dive, no shot. The about is a plain section after the hero */
  @media (prefers-reduced-motion: reduce) {
    .anchor { top: 100svh; }
    .about { position: static; height: auto; margin: 0; padding-block: 18svh; grid-template-columns: auto auto; justify-content: start; }
    .skills { grid-column: 1; } .copy { grid-column: 2; }
    .group li, .group h3 { opacity: 1; scale: 1; }
    .lead strong { background-size: 100% 1px; }
    .about::before { display: none; }
    .copy > *, .w > span { opacity: 1; filter: none; translate: 0; }
    .facts::before { scale: 1 1; }
  }

  /* Corner signature: quiet, editorial, pulled in by the "gravity" as the scene appears. */
  .sig {
    position: absolute;
    top: clamp(20px, 4vw, 40px);
    left: clamp(16px, 4vw, 48px);
    display: grid;
    gap: 6px;
    color: var(--ink);
    text-decoration: none;
    opacity: 0;
    filter: blur(6px);
    transition: opacity 1.6s .6s, filter 1.6s .6s;
  }
  .sig-name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(34px, 4.2vw, 64px);
    line-height: .85;
    letter-spacing: .35em;
    text-shadow: 0 0 40px rgba(255, 150, 60, .25);
    transition: letter-spacing 2.4s cubic-bezier(.16, 1, .3, 1) .6s;
  }
  .l { display: inline-block; will-change: transform; }
  .sig-name sup { font-size: .25em; vertical-align: top; margin-left: .15em; font-family: var(--font-mono); letter-spacing: 0; }
  .sig .mono { font-size: 9px; padding-left: .3em; }
  .ready .sig { opacity: 1; filter: none; }
  /* the parts gravity doesn't move just fade out as the camera starts moving */
  .sig .mono, .sig-name sup { opacity: calc(1 - var(--p, 0) * 2.5); }
  .ready .sig-name { letter-spacing: -.045em; }
  /* fullscreen button: bottom center, quiet; in clean mode it nearly vanishes until hovered */
  .fs {
    position: absolute;
    right: clamp(16px, 4vw, 48px); bottom: clamp(16px, 3vw, 32px);
    display: grid; place-items: center;
    width: 40px; height: 40px;
    color: var(--dim);
    background: rgba(0, 0, 0, .25);
    border: 1px solid rgba(243, 217, 177, .2);
    border-radius: 50%;
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition: color .3s, border-color .3s, opacity .6s;
  }
  .fs .out, :global(html.clean) .fs .in { display: none; }
  :global(html.clean) .fs .out { display: inline; }
  .fs:hover, .fs:focus-visible { color: var(--ink); border-color: rgba(255, 154, 60, .6); }
  :global(html.clean) .fs { opacity: .15; }
  .falling .fs { opacity: 0; pointer-events: none; }
  :global(html.clean) .fs:hover, :global(html.clean) .fs:focus-visible { opacity: 1; }
  :global(html.clean .nav), :global(html.clean) .sig, :global(html.clean) .about { opacity: 0; pointer-events: none; transition: opacity .6s; }
  :global(html.clean) { overflow: hidden; }

  .sig:hover .sig-name { letter-spacing: 0em; transition-duration: .6s; transition-delay: 0s; }
</style>
